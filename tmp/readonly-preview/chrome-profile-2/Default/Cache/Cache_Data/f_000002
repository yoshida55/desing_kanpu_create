      if(e.closest('.fxa_pre')||e.closest('.fxa_wrap')) continue;
      if(e.classList&&(e.classList.contains('__cl_pre')||e.classList.contains('__cl_kid'))) continue; /* クローンのスクロール出現は自前の保険があるので触らない */
