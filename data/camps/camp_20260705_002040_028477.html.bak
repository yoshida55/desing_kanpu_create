        radial-gradient(ellipse 250px 210px at 20% 60%, rgba(115, 175, 215, 0.15) 0%, transparent 46%);
      filter: blur(28px);
      opacity: 0.65;
    }

    .gallery-item {
      position: relative;
      overflow: visible;
    }

    .gallery-item::before {
      content: '';
      position: absolute;
      inset: -40px;
      pointer-events: none;
      z-index: 1;
      border-radius: 20px;
      background:
        radial-gradient(ellipse 280px 220px at 15% 20%, rgba(100, 160, 200, 0.18) 0%, transparent 45%),
