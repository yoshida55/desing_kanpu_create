    <section class="gallery" style="position: relative; background: radial-gradient(circle at 20% 50%, rgba(104, 126, 115, 0.08) 0%, transparent 50%), radial-gradient(circle at 80% 80%, rgba(191, 212, 201, 0.06) 0%, transparent 40%); translate: -3px -170px !important; rotate: 0deg !important; scale: 1 !important; transform-origin: center center !important;" data-cebt="" data-cetx="-3" data-cety="-170">
  <style>
    .gallery-wave-divider {
      width: 100%;
      height: 80px;
      margin-top: 40px;
      display: flex;
      align-items: center;
      overflow: hidden;
      position: relative;
    }
    .gallery-wave-divider svg {
      width: 100%;
      height: 100%;
      display: block;
    }
    .gallery-wave-divider path {
      fill: none;
      stroke: rgba(104, 126, 115, 0.15);
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .gallery-wave-divider path.wave-animate {
      animation: wave-flow 8s linear infinite;
    }
    @keyframes wave-flow {
      0% {
        stroke-dasharray: 200;
        stroke-dashoffset: 0;
      }
      100% {
        stroke-dasharray: 200;
        stroke-dashoffset: -200;
      }
    }
    html.js .gallery-wave-divider {
      opacity: 0;
    }
    html.js .gallery-wave-divider.show {
      opacity: 1;
      animation: fade-in 0.8s ease 0.3s both;
    }
    @keyframes fade-in {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .gallery-item-wrapper {
      position: relative;
    }

    .gallery-item-watercolor {
      position: absolute;
      inset: -40px;
      pointer-events: none;
      z-index: 1;
      border-radius: inherit;
      background:
        radial-gradient(ellipse 280px 220px at 15% 20%, rgba(100, 160, 200, 0.18) 0%, transparent 45%),
