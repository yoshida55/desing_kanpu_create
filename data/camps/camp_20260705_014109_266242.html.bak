          <article class="message-card reveal show in is-visible active visible in-view inview animated revealed aos-animate is-inview is-show reveal-show show-up on enter" data-delay="2" style="animation: auto ease 0s 1 normal none running none; opacity: 1 !important; box-shadow: rgba(0, 0, 0, 0.08) 0px 4px 16px !important;">
