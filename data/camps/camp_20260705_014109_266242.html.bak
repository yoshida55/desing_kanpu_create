    <section id="works" class="" style="min-height: 1228px !important; padding: 100px 24px !important; margin-top: 0px !important; margin-bottom: 0px !important;">
      <div class="container" data-cebt="" data-cetx="0" data-cety="78" style="translate: 0px 78px !important; rotate: 0deg !important; scale: 1 !important; transform-origin: center center !important;">
        <div class="features-top reveal show in is-visible active visible in-view inview animated revealed aos-animate is-inview is-show reveal-show show-up on enter" style="">
