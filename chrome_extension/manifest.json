{
  "manifest_version": 3,
  "name": "デザインストック クリッパー",
  "version": "1.0",
  "description": "右クリックで、見ているサイトのセクションを部品として保存＆サイトをストック登録（86_デザインカンプ作成ツール連携）",
  "permissions": ["contextMenus"],
  "host_permissions": ["http://127.0.0.1:5000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
