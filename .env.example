# これは雛形です。コピーして .env を作り、自分のキーを貼ってください。
#   cp .env.example .env
# その後 .env の値を本物のキーに置き換える（.env はGitに上がりません）。

# Anthropic(Claude) APIキー。雰囲気描写文の生成に使う。
# 取得：https://console.anthropic.com/ → API Keys → Create Key
ANTHROPIC_API_KEY=

# 雰囲気描写に使うモデル（省略可・既定はviewerコード側で設定）
# DESIGN_STOCK_VIBE_MODEL=claude-opus-4-8

# カンプHTML生成のプロバイダ（anthropic / openai / gemini / deepseek / zai）と OpenAI 設定
DESIGN_STOCK_HTML_PROVIDER=anthropic
OPENAI_API_KEY=
DESIGN_STOCK_OPENAI_MODEL=gpt-5.6-terra

# GLM（Zhipu / Z.ai・OpenAI互換・安い）。取得：https://z.ai/ → API Keys
# ZAI_API_KEY=
# DESIGN_STOCK_ZAI_MODEL=glm-5.2   # 最新。安定重視なら glm-4.6
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# サイトライブラリ（DB・スクショ・録画・抜き出し画像）の保存先を変更したい場合に設定。
# 未設定ならプロジェクト内 data/ 配下（従来通り・PCごとに別データ＝家↔会社で共有されない）。
# ナレッジフォルダ（Git同期済み）の中に向けると、家↔会社でDBとスクショが共有される。
# .envはPCごとに別物なので、下記のように「そのPCでの実パス」を書くこと（値はコピーしない）。
#   会社PC: DESIGN_STOCK_LIBRARY_DIR=C:\Users\guest04\Desktop\高橋研三\03_knowledge\ツール\desing_kanpu_create_data
#   自宅PC: DESIGN_STOCK_LIBRARY_DIR=D:\50_knowledge\ツール\desing_kanpu_create_data
# DESIGN_STOCK_LIBRARY_DIR=

# Figma取り込み用（https://www.figma.com/ → Settings → Security → Personal access tokens）
FIGMA_TOKEN=
