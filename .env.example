# これは雛形です。コピーして .env を作り、自分のキーを貼ってください。
#   cp .env.example .env
# その後 .env の値を本物のキーに置き換える（.env はGitに上がりません）。

# Anthropic(Claude) APIキー。雰囲気描写文の生成に使う。
# 取得：https://console.anthropic.com/ → API Keys → Create Key
ANTHROPIC_API_KEY=

# 雰囲気描写に使うモデル（省略可・既定はviewerコード側で設定）
# DESIGN_STOCK_VIBE_MODEL=claude-opus-4-8

# カンプHTML生成のプロバイダ（anthropic / openai / gemini / deepseek / zai）と OpenAI 設定
DESIGN_STOCK_HTML_PROVIDER=anthropic
OPENAI_API_KEY=
DESIGN_STOCK_OPENAI_MODEL=gpt-5.6-terra

# GLM（Zhipu / Z.ai・OpenAI互換・安い）。取得：https://z.ai/ → API Keys
# ZAI_API_KEY=
# DESIGN_STOCK_ZAI_MODEL=glm-5.2   # 最新。安定重視なら glm-4.6
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/
